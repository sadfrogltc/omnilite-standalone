# OmniLite Standalone configuration
# Location: ~/.omnilite-standalone/omnilite-standalone.conf
# Every key can also be given on the command line, e.g. -network=regtest.

# main, test or regtest
network=main

# litecoind RPC. Needs -txindex=1 and an unpruned chain.
rpcconnect=127.0.0.1
#rpcport=9332
#rpcuser=
#rpcpassword=
# Used when rpcpassword is empty. Default: ~/.litecoin/.cookie (testnet4/, regtest/ for the other networks).
#rpccookiefile=

# Seconds between checks for new blocks once synced.
#pollinterval=5

# Blocks of undo data kept for reorgs (minimum 10).
#undodepth=100

# Regtest only: extra senders allowed to send feature activations and alerts
# (OmniLite's -omniactivationallowsender / -omnialertallowsender), comma-separated.
# This changes the computed state, so never set it on mainnet.
#omniactivationallowsender=any
#omnialertallowsender=any

# OmniLite debug categories (OmniLite's -omnidebug), comma-separated, e.g.
# parser,tally or all. Turns on debug output in the log.
#omnidebug=

# JSON-RPC API with OmniLite's omni_* calls (1 = on).
#api=1
# Listen address. Anything but localhost exposes your Omni data to whoever can log in.
#apibind=127.0.0.1
# Default: 9432, test 19432, regtest 19543.
#apiport=9432
# Without apipassword a new cookie is written at start-up: <datadir>/<network>/.cookie
#apiuser=
#apipassword=
